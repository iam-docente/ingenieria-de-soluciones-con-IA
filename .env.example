# ============================================================
# PLANTILLA DE VARIABLES DE ENTORNO
# ============================================================
# Copia este archivo a '.env' y rellena con tus claves reales.
# NUNCA subas el archivo '.env' real a Git.
# ============================================================

# --- OpenRouter (chat) ---
# Obtén tu clave gratis en: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# --- Google AI Studio (embeddings) ---
# Obtén tu clave gratis en: https://ai.google.dev
GEMINI_API_KEY=AIzaSy...

# --- LangSmith (trazabilidad, opcional) ---
# Obtén tu clave gratis en: https://smith.langchain.com
LANGCHAIN_API_KEY=lsv2_...
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=AI-Course

# --- Configuración regional (opcional) ---
TZ=America/Santiago